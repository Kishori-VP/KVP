APP_NAME=Kishori Vikas Program
ENVIRONMENT=development
TIMEZONE=Asia/Kolkata
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=kishori_vikas
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Encrypts AI/OCR/voice provider API keys stored in the database.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=900

# Web Push (PWA notifications). Generate: python -m app.seed.generate_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Optional: email delivery for scheduled/shared reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Stakeholder-only RAG assistant (never put this key in frontend/.env)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
